# 预留模板：后续在 Arch Linux / CI 容器中构建 .pkg.tar.zst 时使用
pkgname=deepseek-chat-bin
pkgver=0.1.3
pkgrel=1
pkgdesc="Multi-provider AI chat client supporting DeepSeek, OpenAI, Anthropic, and Gemini"
arch=('x86_64' 'aarch64')
url="https://github.com/Nanagokyuu/deepseek-chat"
license=('MPL-2.0' 'MIT')
depends=('gtk3' 'nss' 'alsa-lib' 'libxss' 'libsecret')
options=('!strip')

# 使用时将 source 替换为 Release 中的 AppImage 或 linux-unpacked 产物目录
package() {
  install -dm755 "${pkgdir}/opt/deepseek-chat"
  install -dm755 "${pkgdir}/usr/bin"
  install -dm755 "${pkgdir}/usr/share/applications"
  install -dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -dm644 "LICENSE-MIT" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MIT"
}
