{
  "name": "chat-demo",
  "version": "0.1.3",
  "description": "基于 DeepSeek API 的静态聊天示例。",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "rm -rf dist && NODE_ENV=production rspack build -c rspack.config.ts",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts",
    "format": "oxfmt --write .",
    "cap:sync": "pnpm build && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "desktop:sync": "pnpm build && npx cap sync @capawesome/capacitor-electron",
    "desktop:start": "pnpm desktop:sync && cd electron && npm run build && npm start",
    "desktop:pack:mac": "pnpm desktop:sync && cd electron && npm run pack:mac",
    "desktop:pack:win": "pnpm desktop:sync && cd electron && npm run pack:win",
    "desktop:pack:linux": "pnpm desktop:sync && cd electron && npm run pack:linux"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@mozilla/readability": "^0.6.0",
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mammoth": "^1.13.0",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "pdfjs-dist": "^6.5.438",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capawesome/capacitor-electron": "^0.2.2",
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "7.0.2"
  }
}
